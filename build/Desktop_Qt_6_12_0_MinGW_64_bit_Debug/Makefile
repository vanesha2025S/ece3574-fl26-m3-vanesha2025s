	$(MAKE) $(MAKESILENT) -f CMakeFiles\ai_workspace_m3.dir\build.make CMakeFiles/ai_workspace_m3.dir/src/workspace_widget.cpp.s
.PHONY : src/workspace_widget.cpp.s

